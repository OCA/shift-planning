<?xml version="1.0" ?>
<odoo>
    <record id="shift_area_form" model="ir.ui.view">
        <field name="model">hr.shift.area</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="shift_area_tree" model="ir.ui.view">
        <field name="model">hr.shift.area</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="shift_area_action" model="ir.actions.act_window">
        <field name="name">Shift Areas</field>
        <field name="res_model">hr.shift.area</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="shift_area_menu"
        name="Areas"
        parent="hr_shift.shift_planning_root"
        action="shift_area_action"
        sequence="30"
        groups="hr_shift.group_shift_manager"
    />
</odoo>
