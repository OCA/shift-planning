<?xml version="1.0" ?>
<odoo>
    <record id="shift_pattern_week_form" model="ir.ui.view">
        <field name="model">hr.shift.pattern.week</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="name" />
                        <field name="color" widget="color_picker" />
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="day_number" />
                            <field name="template_id" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="shift_pattern_week_tree" model="ir.ui.view">
        <field name="model">hr.shift.pattern.week</field>
        <field name="arch" type="xml">
            <list>
                <field name="color" widget="color_picker" />
                <field name="name" />
            </list>
        </field>
    </record>
    <record id="shift_pattern_week_action" model="ir.actions.act_window">
        <field name="name">Week templates</field>
        <field name="res_model">hr.shift.pattern.week</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
