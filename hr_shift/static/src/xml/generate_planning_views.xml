<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ShiftPlanning.generate_planning_button" owl="1">
        <t t-if="showGeneratePlanning">
            <button
                type="button"
                class="btn btn-secondary o_button_generate_planning"
                t-on-click.prevent="onGeneratePlanning"
            >
            Generate Planning
        </button>
        </t>
    </t>

    <t
        t-name="hr_shift.ListView.Buttons"
        t-inherit="web.ListView.Buttons"
        t-inherit-mode="primary"
        owl="1"
    >
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <t t-call="ShiftPlanning.generate_planning_button" />
        </xpath>
    </t>

    <t
        t-name="hr_shift.KanbanView.Buttons"
        t-inherit="web.KanbanView.Buttons"
        t-inherit-mode="primary"
        owl="1"
    >
        <xpath expr="//div[hasclass('o_cp_buttons')]" position="inside">
            <t t-call="ShiftPlanning.generate_planning_button" />
        </xpath>
    </t>
</templates>
